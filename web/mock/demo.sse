event: section_final
data: {"section": 2, "kind": "body", "heading": "品牌要怎样进入 AI 的答案", "text": "LLM-原生 GEO 是深度适配大语言模型底层架构及其交互逻辑的技术体系[S8]。它的第一个注入点是实时外部索引环节：让品牌内容进入大模型的「外部参考资料」，先被 AI 看见[S6]。更进一步，是进入大模型的先验知识，让品牌被 AI 记住[S7]。与传统 GEO 的关键词匹配不同，它依靠语义理解来匹配用户意图[S9]。", "sentences": [{"idx": 0, "text": "LLM-原生 GEO 是深度适配大语言模型底层架构及其交互逻辑的技术体系[S8]。", "cites": ["S8"]}, {"idx": 1, "text": "它的第一个注入点是实时外部索引环节：让品牌内容进入大模型的「外部参考资料」，先被 AI 看见[S6]。", "cites": ["S6"]}, {"idx": 2, "text": "更进一步，是进入大模型的先验知识，让品牌被 AI 记住[S7]。", "cites": ["S7"]}, {"idx": 3, "text": "与传统 GEO 的关键词匹配不同，它依靠语义理解来匹配用户意图[S9]。", "cites": ["S9"]}], "citations": {"S8": {"fact_id": "p04-f01", "page_no": 4, "text": "LLM-原生GEO : 深度适配大语言模型 (LLM) 底层架构及其交互逻辑的技术体系。", "status": "verified"}, "S6": {"fact_id": "p05-v26", "page_no": 5, "text": "GEO Phase 1 的注入点是 实时外部索引（RAG）环节：植入RAG，被AI看见，即进入大模型的“外部参考资料”", "status": "image_structural"}, "S7": {"fact_id": "p05-v27", "page_no": 5, "text": "GEO Phase 2 的注入点是 大模型先验知识 环节：植入大模型“大脑”，被AI记住", "status": "image_structural"}, "S9": {"fact_id": "p04-v14", "page_no": 4, "text": "意图匹配上，LLM-原生GEO 靠语义理解，传统GEO 靠关键词匹配", "status": "image_structural"}}, "insufficient": false}

