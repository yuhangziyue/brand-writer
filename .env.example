# ── 模型提供方 ────────────────────────────────────────────────
# 生成与判别。可选 deepseek / qwen / claude / none
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_JUDGE_MODEL=deepseek-chat

# 页面解析用的多模态模型。只在 make build 时用一次，结果入库，
# 评审人不需要这个 key（build/ 已带解析结果）
VLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen2.5-vl-72b-instruct

# 备选：Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── 运行模式 ──────────────────────────────────────────────────
# 1 = 离线回放模式。不调任何模型，全链路回放 build/fixtures 里一次真实运行的结果。
# 没填 key 时系统也会自动进入这个模式，并在界面标注「回放模式」
DEMO_OFFLINE=0

# 稠密检索开关。0 = 只用 BM25（无需下载 2GB 模型）
USE_DENSE=1
EMBED_MODEL=BAAI/bge-m3
# 重排开关。小语料上收益有限，评估里有有无重排的对照实验
USE_RERANK=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
