# ── 模型（OpenAI 兼容协议，换厂商只改这三行）────────────────────────
# 不填 LLM_API_KEY：/v1/chat 自动进入离线回放模式，播放 build/fixtures 里的真实运行录像
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# V5 判别 / 评估用的模型；不填则与 LLM_MODEL 相同（同源评审有盲区，见 README「已知局限」）
LLM_JUDGE_MODEL=
EVAL_JUDGE_MODEL=
# 页卡解析的多模态模型（只在重新建库时用；仓库已带解析结果）
LLM_VLM_MODEL=
# 本项目全程关闭思考，见 llm/client.py 注释
LLM_REASONING_EFFORT=none
LLM_TIMEOUT=120
# 0 = 不用流式（中转不支持流式时），按句切片模拟流式
LLM_STREAM=1

# ── 检索 ─────────────────────────────────────────────────────────
# 1 = BM25 + bge-m3 混合检索（需 pip install -e '.[dense]'，模型约 2GB）
# 0 = 只用 BM25。注意：BM25 单路下资料充分性判断不可靠（标定集 18 题错 3 题）
USE_DENSE=1
EMBED_MODEL=BAAI/bge-m3

# ── 路径（一般不用改，默认相对仓库根目录）────────────────────────────
# RAG_DB=build/index/rag.db
# SESSIONS_DB=build/runtime/sessions.db
# FIXTURES_DIR=build/fixtures
# PAGES_JSONL=build/pages.jsonl
# REPLAY_SPEED=1
